# ═══════════════════════════════════════════════════════════════════════════
#  TGD Bot v11 — Docker VPS platform configuration
#
#  Copy to `.env` and fill in the blanks.  The installer never overwrites an
#  existing `.env`.  Keep this file OUT of version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Discord bot ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=
BOT_NAME=TGD Bot
PREFIX=!
BOT_VERSION=11.0-DOCKER
BOT_DEVELOPER=ShadowGamerIND
BOT_THUMBNAIL_URL=
BOT_ICON_URL=
SUPPORT_INVITE_URL=

# Snowflake ids (bot owner + the role given to VPS owners)
MAIN_ADMIN_ID=
VPS_USER_ROLE_ID=
# Extra admins, comma separated. Blank = use MAIN_ADMIN_ID.
OWNER_IDS=

# Public address shown in `ssh root@… -p …` commands
YOUR_SERVER_IP=127.0.0.1

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_PATH=./vps.db
DATABASE_BACKUP_DIR=./backups
MIGRATION_REPORT_DIR=./migration_reports

# Master key for the root-password vault.  If blank a key is generated at
# `.secret_key` (mode 0600).  Losing it means stored passwords cannot be read.
SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════════════
#  DOCKER BACKEND
# ═══════════════════════════════════════════════════════════════════════════

# Engine endpoint for the local node.
DOCKER_HOST_URL=unix:///var/run/docker.sock
DOCKER_API_VERSION=
DOCKER_API_TIMEOUT=30
DOCKER_IMAGE_PULL_TIMEOUT=600
DOCKER_OPERATION_TIMEOUT=180
DOCKER_START_TIMEOUT=120
DOCKER_STOP_TIMEOUT=60
DOCKER_EXEC_TIMEOUT=120
DOCKER_MAX_RETRIES=3
DOCKER_RETRY_BACKOFF=1.5

# Never let a burst of commands melt a node.
DOCKER_MAX_CONCURRENT_PULLS=2
DOCKER_MAX_CONCURRENT_CREATES=2
DOCKER_WORKER_THREADS=8

# ── Images ──────────────────────────────────────────────────────────────────
DOCKER_DEFAULT_IMAGE=ubuntu:24.04
DOCKER_BACKUP_HELPER_IMAGE=alpine:3.20
# Separately gated Proxmox workload (requires a trusted KVM/FUSE Docker node).
# Docker tags do not carry the repository release's leading "v".
PROXMOX_IMAGE=dockurr/proxmox:9.2.20
PROXMOX_REQUIRE_KVM=true
PROXMOX_REQUIRE_FUSE=true
PROXMOX_READY_ATTEMPTS=90
PROXMOX_READY_INTERVAL=2.0
DOCKER_ALLOW_CUSTOM_IMAGES=true
DOCKER_ALWAYS_PULL=false

# ── Networking and published ports ──────────────────────────────────────────
DOCKER_DEFAULT_NETWORK=bridge
DOCKER_CREATE_NETWORK=true
DOCKER_NETWORK_SUBNET=

# Host address the published ports bind to.  0.0.0.0 = every interface.
DOCKER_PUBLISH_IP=0.0.0.0

DOCKER_SSH_PORT_START=22000
DOCKER_SSH_PORT_END=22999
DOCKER_PORT_RANGE_START=25000
DOCKER_PORT_RANGE_END=26999
# Never handed out, e.g. "8080,9000"
DOCKER_RESERVED_PORTS=

# ── Default plan ────────────────────────────────────────────────────────────
DOCKER_DEFAULT_RAM=1024
DOCKER_DEFAULT_CPU=1
DOCKER_DEFAULT_STORAGE=10
DOCKER_DEFAULT_PID_LIMIT=512
DOCKER_CPU_PERIOD=100000
DOCKER_MEMORY_RESERVATION_RATIO=0.75
DOCKER_NOFILE_LIMIT=65536

# ── Storage ─────────────────────────────────────────────────────────────────
DOCKER_VPS_DATA_DIR=/var/lib/tgdbot/vps
DOCKER_BACKUP_DIR=/var/backups/tgdbot
DOCKER_RUNTIME_DIR=/var/lib/tgdbot/runtime
DOCKER_SECRET_DIR=/var/lib/tgdbot/secrets
DOCKER_VOLUME_PREFIX=tgdbot_
# Real host-level quotas (XFS pquota / Btrfs qgroups).  When the host cannot
# enforce them the bot reports "monitored only" instead of a fake limit.
DOCKER_ENFORCE_DISK_QUOTA=true
DOCKER_BACKUP_KEEP=4
DOCKER_BACKUP_RETENTION_DAYS=30
# 0 = manual backups only
DOCKER_BACKUP_INTERVAL_HOURS=0

# ── Security policy ─────────────────────────────────────────────────────────
# NEVER enable in production: a privileged container is root on the host.
DOCKER_PRIVILEGED=false
# Breaks su/sudo and PAM-backed sshd root logins — opt in only if you know why.
DOCKER_NO_NEW_PRIVILEGES=false
DOCKER_DROP_CAPABILITIES=true
DOCKER_CONTAINER_INIT=true
DOCKER_SECCOMP_PROFILE=
DOCKER_APPARMOR_PROFILE=
DOCKER_USERNS_MODE=

# ── Guest initialization ────────────────────────────────────────────────────
SSH_CONTAINER_PORT=22
SSH_READY_ATTEMPTS=30
SSH_READY_INTERVAL=1.0
SSH_VERIFY_LOGIN=true
# Optional branding script run inside a fresh VPS on first boot.
HOST_MOTD=

# ── Monitoring ──────────────────────────────────────────────────────────────
DOCKER_STATS_TIMEOUT=15
DOCKER_STATS_MAX_PARALLEL=8
HOST_SNAPSHOT_INTERVAL=60
HOST_SNAPSHOT_KEEP=720
STATS_REFRESH_SECONDS=5
MAX_LIVE_REFRESHES=60

# ═══════════════════════════════════════════════════════════════════════════
#  VPS LIFECYCLE (unchanged from v10)
# ═══════════════════════════════════════════════════════════════════════════
DEFAULT_VPS_EXPIRATION_DAYS=30
EXPIRATION_WARNING_DAYS=3
EXPIRATION_AUTO_SUSPEND=true
EXPIRATION_CHECK_INTERVAL=900

# ── Public self-service creation (!vps create) ──────────────────────────────
PUBLIC_VPS_ENABLED=true
PUBLIC_VPS_MAX_RAM=8
PUBLIC_VPS_MAX_CPU=2
PUBLIC_VPS_MAX_DISK=40
PUBLIC_VPS_EXPIRY_DAYS=3
PUBLIC_VPS_MAX_PER_USER=1
PUBLIC_VPS_MAX_PER_IP=1
PUBLIC_VPS_REQUIRE_VERIFICATION=false
PUBLIC_VPS_GLOBAL_LIMIT=100
PUBLIC_VPS_RENEWAL_ENABLED=true
PUBLIC_VPS_RENEWAL_DAYS=3
PUBLIC_VPS_RENEWAL_WINDOW_DAYS=1
PUBLIC_VPS_COOLDOWN_HOURS=24
PUBLIC_VPS_REQUIRE_ACCOUNT_AGE=3

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_COOLDOWN=2
RATE_LIMIT_BURST=5
RATE_LIMIT_MAX_VIOLATIONS=5
RATE_LIMIT_ABUSE_TIMEOUT=120

# ── Command timeouts / panels ───────────────────────────────────────────────
COMMAND_TIMEOUT_SECONDS=240
MANAGE_PANEL_TIMEOUT=300
CONSOLE_PANEL_TIMEOUT=600

# ═══════════════════════════════════════════════════════════════════════════
#  WEB SSH TERMINAL
# ═══════════════════════════════════════════════════════════════════════════
WEBSSH_ENABLED=true
WEBSSH_HOST=0.0.0.0
WEBSSH_PORT=5000
WEBSSH_SERVER_IP=127.0.0.1
WEBSSH_URL_FORMAT=http://{SERVER_IP}:{PORT}
WEBSSH_SESSION_TTL=1800
WEBSSH_MAX_SESSIONS=200
WEBSSH_SESSION_MAX_PER_IP=8
WEBSSH_DEFAULT_PIN=false
WEBSSH_PIN_ATTEMPTS=5
WEBSSH_CONNECT_TIMEOUT=15
# SECURITY: leave false.  When true a browser could dial an arbitrary host
# through the terminal instead of only a bot-issued link.
WEBSSH_ALLOW_ADHOC=false

# ═══════════════════════════════════════════════════════════════════════════
#  ANIMATION (unchanged from v10)
# ═══════════════════════════════════════════════════════════════════════════
ANIM_ENABLED=true
ANIM_SPEED=1.0
ANIM_FRAME_SECONDS=0.9
TYPEWRITER_ENABLED=true
TYPEWRITER_SPEED=0.9
LIVE_REFRESH_SECONDS=5
LIVE_MAX_MINUTES=30
LIVE_FLEET_REFRESH=12
AUTO_REFRESH_MANAGE=true
MANAGE_REFRESH_SECONDS=12
TYPING_INDICATORS=true
GRAPH_POINTS=28
